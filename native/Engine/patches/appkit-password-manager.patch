+// Versioned, UI-thread-only AppKit password presentation and exclusive provider.
+using ArcNativePasswordNotice = void (*)(int, uint64_t, const char*, const char*, int);
+extern "C" void arcreborn_set_native_password_prompt(
+    void (*)(void*, uint64_t, const char*, const char*, int));
+extern "C" void arcreborn_cancel_native_password_prompt(void*);
+extern "C" int arcreborn_respond_native_password_prompt(void*, uint64_t, int);
+namespace {
+ArcNativePasswordNotice arc_native_password_notice = nullptr;
+void ArcDispatchPasswordNotice(void* opaque, uint64_t request,
+                              const char* origin, const char* username, int kind) {
+  auto base = CefBrowserHostBase::GetBrowserForContents(
+      static_cast<content::WebContents*>(opaque));
+  if (base && arc_native_password_notice)
+    arc_native_password_notice(base->GetIdentifier(), request, origin, username, kind);
+}
+}
+extern "C" CEF_EXPORT void browser_set_password_prompt_v1(ArcNativePasswordNotice callback) {
+  CEF_REQUIRE_UIT();
+  arcreborn_set_native_password_prompt(callback ? ArcDispatchPasswordNotice : nullptr);
+  arc_native_password_notice = callback;
+}
+extern "C" CEF_EXPORT int browser_respond_password_prompt_v1(
+    int browser_id, uint64_t request, int action) {
+  CEF_REQUIRE_UIT_RETURN(0);
+  auto base = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!base || !base->IsChromeStyle() || !base->IsValid()) return 0;
+  return arcreborn_respond_native_password_prompt(
+      ChromeBrowserHostImpl::FromBaseChecked(base)->GetWebContents(), request, action);
+}
+extern "C" CEF_EXPORT int browser_configure_password_manager_v1(
+    int browser_id, const char* provider) {
+  CEF_REQUIRE_UIT_RETURN(0);
+  if (!provider) return 0;
+  const std::string selected(provider);
+  const bool external = selected != "native";
+  if (external && (selected.size() != 32 ||
+      selected.find_first_not_of("abcdefghijklmnop") != std::string::npos)) return 0;
+  auto base = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!base || !base->IsChromeStyle() || !base->IsValid()) return 0;
+  auto host = ChromeBrowserHostImpl::FromBaseChecked(base);
+  auto* contents = host->GetWebContents();
+  if (!contents) return 0;
+  auto* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  auto* prefs = profile->GetPrefs();
+  prefs->SetBoolean("arcreborn.password_manager_external", external);
+  prefs->SetString("arcreborn.password_manager_provider", selected);
+  if (external) {
+    arcreborn_cancel_native_password_prompt(contents);
+    contents->ForEachRenderFrameHost([](content::RenderFrameHost* frame) {
+      if (auto* driver = password_manager::ContentPasswordManagerDriver::GetForRenderFrameHost(frame)) {
+        driver->GetPasswordAutofillManager()->DeleteFillData();
+        driver->InformNoSavedCredentials(false);
+      }
+    });
+  }
+  auto* registry = extensions::ExtensionRegistry::Get(profile);
+  auto* registrar = extensions::ExtensionRegistrar::Get(profile);
+  auto* extension_prefs = extensions::ExtensionPrefs::Get(profile);
+  if (!registry || !registrar || !extension_prefs) return 0;
+  // Track only extensions paused by this feature. Never reactivate an extension
+  // the user had already disabled, or one blocked for another reason.
+  auto paused = prefs->GetList("arcreborn.paused_password_extensions").Clone();
+  base::ListValue remaining;
+  for (const auto& value : paused) {
+    if (!value.is_string()) continue;
+    const auto& id = value.GetString();
+    if (!external || id == selected) {
+      if (extension_prefs->GetDisableReasons(id) ==
+          extensions::DisableReasonSet{extensions::disable_reason::DISABLE_USER_ACTION})
+        registrar->EnableExtension(id);
+    } else remaining.Append(id);
+  }
+  constexpr const char* managers[] = {
+    "ghmbeldphafepmbegfdlkpapadhbakde", "aeblfdkhhhdcdjpifhhbdiojplfjncoa",
+    "nngceckbapebfimnlniiiahkandclblb", "fdjamakpfbbddfjaooikfcpapjohcfmg",
+    "bfogiafebfohielmmehodmfbbebbbpei", "hdokiejnpimakedhajhdlcegeplioahd",
+    "oboonakemofpalcgghocfoadofidjkkk", "pejdijmoenmkgeppbflobdenhhabjlaj"
+  };
+  if (external) for (const char* id : managers) {
+    if (selected != id && registry->enabled_extensions().Contains(id)) {
+      remaining.Append(id);
+      registrar->DisableExtension(id, {extensions::disable_reason::DISABLE_USER_ACTION});
+    }
+  }
+  if (external && registry->disabled_extensions().Contains(selected) &&
+      extension_prefs->GetDisableReasons(selected) ==
+          extensions::DisableReasonSet{extensions::disable_reason::DISABLE_USER_ACTION})
+    registrar->EnableExtension(selected);
+  prefs->SetList("arcreborn.paused_password_extensions", std::move(remaining));
+  return 1;
+}
