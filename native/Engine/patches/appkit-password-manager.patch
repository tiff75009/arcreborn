+// Arc Reborn keeps the secret and the form manager in Chromium. The native
+// presenter receives only an origin and username, never the password.
+namespace {
+using ArcPasswordHandler = void (*)(void*, uint64_t, const char*, const char*, int);
+ArcPasswordHandler arc_password_handler = nullptr;
+uint64_t arc_password_sequence = 0;
+struct ArcPasswordRequest {
+  uint64_t id;
+  bool update;
+  std::unique_ptr<password_manager::PasswordFormManagerForUI> form;
+};
+auto& ArcPasswordRequests() {
+  static base::NoDestructor<std::map<content::WebContents*, ArcPasswordRequest>> requests;
+  return *requests;
+}
+void CancelArcPasswordRequest(content::WebContents* contents) {
+  auto it = ArcPasswordRequests().find(contents);
+  if (it == ArcPasswordRequests().end()) return;
+  const auto id = it->second.id;
+  it->second.form->OnNoInteraction(it->second.update);
+  ArcPasswordRequests().erase(it);
+  if (arc_password_handler) arc_password_handler(contents, id, "", "", -1);
+}
+}  // namespace
+extern "C" void arcreborn_set_native_password_prompt(ArcPasswordHandler handler) {
+  while (!ArcPasswordRequests().empty())
+    CancelArcPasswordRequest(ArcPasswordRequests().begin()->first);
+  arc_password_handler = handler;
+}
+extern "C" void arcreborn_cancel_native_password_prompt(void* contents) {
+  CancelArcPasswordRequest(static_cast<content::WebContents*>(contents));
+}
+extern "C" int arcreborn_respond_native_password_prompt(
+    void* opaque, uint64_t request, int action) {
+  auto* contents = static_cast<content::WebContents*>(opaque);
+  auto it = ArcPasswordRequests().find(contents);
+  if (it == ArcPasswordRequests().end() || it->second.id != request ||
+      action < 0 || action > 2) return 0;
+  auto pending = std::move(it->second);
+  ArcPasswordRequests().erase(it);
+  auto* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  if (!profile || profile->IsOffTheRecord() ||
+      profile->GetPrefs()->GetBoolean("arcreborn.password_manager_external") ||
+      !profile->GetPrefs()->GetBoolean("credentials_enable_service")) {
+    pending.form->OnNoInteraction(pending.update);
+    return 0;
+  }
+  if (action == 1) pending.form->Save();
+  else if (action == 2 && !pending.update) pending.form->OnNeverClicked();
+  else pending.form->OnNoInteraction(pending.update);
+  return 1;
+}
