+void RenderWidgetHostNSViewBridge::EnableNativeDisplay() {
+  if (!display_disabled_) return;
+  display_ca_layer_tree_ = std::make_unique<ui::DisplayCALayerTree>(background_layer_);
+  // Unlike initial construction, the native view already has its final size.
+  // Seed the new flipped layer; an autoresizing mask only handles later deltas.
+  background_layer_.sublayers.lastObject.frame = background_layer_.bounds;
+  display_disabled_ = false;
+}
