+content::WebContents* BrowserContentsForNativeHost(int browser_id, bool attach) {
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!host || !host->IsValid() || !host->IsChromeStyle()) return nullptr;
+  auto cef_view = CefBrowserView::GetForBrowser(host);
+  if (!cef_view) return nullptr;
+  auto* view = static_cast<CefBrowserViewImpl*>(cef_view.get())->web_view();
+  if (!view) return nullptr;
+  if (attach) views::BrowserSetExternalNativeHost(view);
+  return views::BrowserHasExternalNativeHost(view) ? host->GetWebContents() : nullptr;
+}
