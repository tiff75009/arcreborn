+// Private ABI for the native AppKit embedder. The Chrome Browser/WebContents
+// remain intact; only their native surface changes host, via NativeViewHost's
+// detach lifecycle (including remote-cocoa and accessibility cleanup).
+content::WebContents* BrowserContentsForNativeHost(int browser_id, bool attach);
+extern "C" CEF_EXPORT void* browser_attach_native_view_v1(int browser_id, void* parent) {
+  CEF_REQUIRE_UIT_RETURN(nullptr);
+  NSView* container = (__bridge NSView*)parent;
+  if (!container) return nullptr;
+  auto* contents = BrowserContentsForNativeHost(browser_id, true);
+  if (!contents) return nullptr;
+  NSView* view = contents->GetNativeView().GetNativeNSView();
+  if (view.superview != container) [container addSubview:view];
+  view.frame = container.bounds;
+  view.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+  view.hidden = container.hiddenOrHasHiddenAncestor;
+  return (__bridge void*)view;
+}
+extern "C" CEF_EXPORT int browser_native_view_visibility_v1(int browser_id, int visible) {
+  CEF_REQUIRE_UIT_RETURN(0);
+  auto* contents = BrowserContentsForNativeHost(browser_id, false);
+  if (!contents) return 0;
+  NSView* view = contents->GetNativeView().GetNativeNSView();
+  view.hidden = !visible;
+  if (visible) contents->WasShown(); else contents->WasHidden();
+  return 1;
+}
