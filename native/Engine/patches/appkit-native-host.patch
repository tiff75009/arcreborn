+// Browser-private integration: keep the Chrome WebView and its observers, but
+// relinquish its NativeViewHost. AppKit owns geometry, visibility and focus.
+WEBVIEW_EXPORT bool BrowserHasExternalNativeHost(WebView* view) {
+  return view && view->GetProperty(kBrowserExternalNativeHost);
+}
+WEBVIEW_EXPORT void BrowserSetExternalNativeHost(WebView* view) {
+  if (BrowserHasExternalNativeHost(view)) return;
+  view->SetProperty(kBrowserExternalNativeHost, true);
+  for (const auto& child : view->children()) {
+    if (auto* holder = AsViewClass<NativeViewHost>(child.get())) holder->Detach();
+  }
+}
 
