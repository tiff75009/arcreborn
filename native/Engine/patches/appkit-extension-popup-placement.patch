 views::BubbleBorder::Arrow ExtensionsToolbarDesktop::GetPopupArrow() const {
-  // Browser's actions live on the left. Keep the popup's leading corner at
-  // the AppKit button, letting the existing bubble layout constrain to screen.
   if (popup_owner_) {
     const auto icon = icons_.find(popup_owner_->GetId());
-    if (icon != icons_.end() && icon->second->HasNativeActionAnchor())
-      return views::BubbleBorder::TOP_LEFT;
+    if (icon != icons_.end() && icon->second->HasNativeActionAnchor()) {
+      // Mac calculates the renderer's autosize limit from this corner before
+      // loading the popup. Positioning the NSWindow afterward is too late.
+      const gfx::Rect anchor = icon->second->GetAnchorBoundsInScreen();
+      const gfx::Rect work = display::Screen::Get()
+                                 ->GetDisplayNearestPoint(anchor.CenterPoint())
+                                 .work_area();
+      const gfx::Rect page = gfx::IntersectRects(
+          icon->second->GetWidget()->GetWindowBoundsInScreen(), work);
+      const int left = anchor.right() - work.x();
+      const int right = work.right() - anchor.x();
+      const int below = work.bottom() - anchor.bottom();
+      const int above = anchor.y() - work.y();
+      // Open toward the page (sidebar on the left, classic toolbar actions on
+      // the right). If that side is constrained, use the roomier screen side.
+      const int width = std::min(extensions::kExtensionPopupMaxSize.width(),
+                                 page.IsEmpty() ? work.width() : page.width());
+      bool toward_left = anchor.CenterPoint().x() >
+                         (page.IsEmpty() ? work : page).CenterPoint().x();
+      if ((toward_left ? left : right) < width && left != right)
+        toward_left = left > right;
+      const bool upward = below < extensions::kExtensionPopupMaxSize.height()
+                          && above > below;
+      using Border = views::BubbleBorder;
+      const auto corner = upward
+          ? (toward_left ? Border::BOTTOM_RIGHT : Border::BOTTOM_LEFT)
+          : (toward_left ? Border::TOP_RIGHT : Border::TOP_LEFT);
+      // BubbleDialogDelegate interprets its input arrow in reading order.
+      return base::i18n::IsRTL() ? Border::horizontal_mirror(corner) : corner;
+    }
   }
   return views::BubbleBorder::TOP_RIGHT;
 }
