+void ToolbarActionView::SetNativeActionAnchor(const gfx::Rect& screen_rect) {
+  if (!GetWidget()) {
+    native_action_anchor_.reset();
+    return;
+  }
+  gfx::Rect rect = screen_rect;
+  rect.Offset(-GetWidget()->GetWindowBoundsInScreen().origin().OffsetFromOrigin());
+  native_action_anchor_ = rect;
+}
+
 gfx::Rect ToolbarActionView::GetAnchorBoundsInScreen() const {
+  if (native_action_anchor_ && GetWidget()) {
+    gfx::Rect rect = *native_action_anchor_;
+    rect.Offset(GetWidget()->GetWindowBoundsInScreen().origin().OffsetFromOrigin());
+    return rect;
+  }
   gfx::Rect bounds = GetBoundsInScreen();
   bounds.Inset(GetToolbarInkDropInsets(this));
   return bounds;
