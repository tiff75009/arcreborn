+// Browser's private, versioned ABI. Called only from its AppKit event handlers
+// on the UI thread. No renderer binding, JS injection, or debugging socket.
+extern "C" CEF_EXPORT int browser_execute_extension_action_v1(
+    int browser_id, const char* extension_id, int x, int y, int width, int height) {
+  CEF_REQUIRE_UIT_RETURN(-1);
+  if (!extension_id || width < 1 || height < 1 || width > 512 || height > 512 ||
+      x < -1048576 || x > 1048576 || y < -1048576 || y > 1048576) {
+    return -2;
+  }
+  // Bound the scan; extension IDs are exactly 32 lowercase a-p characters.
+  for (int i = 0; i < 32; ++i) {
+    if (extension_id[i] < 'a' || extension_id[i] > 'p') return -2;
+  }
+  if (extension_id[32] != '\0') return -2;
+
+  auto base = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!base || !base->IsChromeStyle() || !base->IsValid()) return -3;
+  auto host = ChromeBrowserHostImpl::FromBaseChecked(base);
+  Browser* browser = host->browser();
+  if (!browser || !host->GetWebContents() ||
+      browser->tab_strip_model()->GetActiveWebContents() != host->GetWebContents()) {
+    return -4;
+  }
+  auto* chrome_view = host->chrome_browser_view();
+  auto* toolbar = chrome_view ? chrome_view->toolbar() : nullptr;
+  auto* desktop = toolbar ? toolbar->extensions_container() : nullptr;
+  auto* container = ExtensionsContainer::From(*browser);
+  if (!container || !desktop) return -5;
+  auto* action = container->GetActionForId(extension_id);
+  auto* view = desktop->GetViewForId(extension_id);
+  if (!action || !view || !view->GetWidget()) return -6;
+
+  // Keep Chromium's popup, tab permission grant, click event, and side-panel
+  // dispatch. Opening an action must not change the user's pin preferences.
+  view->SetNativeActionAnchor(gfx::Rect(x, y, width, height));
+  if (action->IsShowingPopup()) {
+    action->HidePopup();
+  } else {
+    action->ExecuteUserAction(ToolbarActionViewModel::InvocationSource::kToolbarButton);
+  }
+  return 0;
+}
+
+extern "C" CEF_EXPORT int browser_close_extension_popup_v1(int browser_id) {
+  CEF_REQUIRE_UIT_RETURN(-1);
+  auto base = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!base || !base->IsChromeStyle() || !base->IsValid()) return -3;
+  auto host = ChromeBrowserHostImpl::FromBaseChecked(base);
+  if (!host->browser()) return -4;
+  auto* container = ExtensionsContainer::From(*host->browser());
+  if (!container) return -5;
+  container->HideActivePopup();
+  return 0;
+}
