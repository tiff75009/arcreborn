+
+// State: 0 closed, 1 opening, 2 visible. No retained native pointers cross ABI.
+extern "C" CEF_EXPORT int browser_extension_popup_state_v1(
+    int browser_id, const char* extension_id, int* bounds) {
+  CEF_REQUIRE_UIT_RETURN(0);
+  if (!extension_id || !bounds) return 0;
+  auto base = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  if (!base || !base->IsChromeStyle() || !base->IsValid()) return 0;
+  auto host = ChromeBrowserHostImpl::FromBaseChecked(base);
+  if (!host->browser()) return 0;
+  auto* container = ExtensionsContainer::From(*host->browser());
+  auto* action = container ? container->GetActionForId(extension_id) : nullptr;
+  if (!action || !action->IsShowingPopup()) return 0;
+  auto* widget = views::Widget::GetWidgetForNativeView(action->GetPopupNativeView());
+  if (!widget || !widget->IsVisible()) return 1;
+  auto rect = widget->GetWindowBoundsInScreen();
+  bounds[0] = rect.x(); bounds[1] = rect.y();
+  bounds[2] = rect.width(); bounds[3] = rect.height();
+  return 2;
+}
