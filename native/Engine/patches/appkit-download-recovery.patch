+void CefDownloadManagerDelegateImpl::AttachForRecovery(DownloadItem* item,
+                                                      CefBrowserHostBase* browser) {
+  if (item_browser_map_.contains(item))
+    OnDownloadDestroyed(item);
+  item_browser_map_[item] = browser;
+  item->AddObserver(this);
+  if (!browser->HasObserver(this))
+    browser->AddObserver(this);
+}
