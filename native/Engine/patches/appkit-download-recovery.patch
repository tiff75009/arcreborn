+extern "C" CEF_EXPORT void browser_download_info_v1(
+    int browser_id, uint32_t id, void* context,
+    void (*receive)(void*, const char*, const char*, bool)) {
+  CEF_REQUIRE_UIT_RETURN_VOID();
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  auto* bc = host ? host->GetBrowserContext() : nullptr;
+  auto* item = bc ? bc->GetDownloadManager()->GetDownload(id) : nullptr;
+  if (item && receive)
+    receive(context, item->GetGuid().c_str(), item->GetTargetFilePath().value().c_str(),
+            CanKeepPartial(item));
+}
+
+// Returns -1 while the profile loads its history, 0 if a restart is
+// required and 1 after successfully handing the item back to Chromium.
+extern "C" CEF_EXPORT int browser_recover_download_v1(
+    int browser_id, const char* guid, const char* source, uint32_t legacy_id,
+    const char* partial_path, void* context, void (*identify)(void*, const char*)) {
+  CEF_REQUIRE_UIT_RETURN(0);
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(browser_id);
+  auto* bc = host ? host->GetBrowserContext() : nullptr;
+  if (!bc || !guid || !source)
+    return 0;
+  auto* manager = bc->GetDownloadManager();
+  auto* service = DownloadCoreServiceFactory::GetForBrowserContext(bc);
+  if (service)
+    service->InitializeHistory(DownloadCoreService::DownloadHistoryLoadTrigger::kDownloadsPage);
+  if (!manager->IsManagerInitialized())
+    return -1;
+  auto* item = identify ? manager->GetDownload(legacy_id) : manager->GetDownloadByGuid(guid);
+  auto found = RecoveryDelegates().find(manager);
+  if (found == RecoveryDelegates().end() || !CanKeepPartial(item) ||
+      item->GetState() != DownloadItem::INTERRUPTED || item->GetURL() != GURL(source))
+    return 0;
+  if (identify) {
+    if (!partial_path || item->GetFullPath() != base::FilePath(partial_path))
+      return 0;
+    identify(context, item->GetGuid().c_str());
+    return 1;
+  }
+  found->second->AttachForRecovery(item, host.get());
+  item->Resume(true);
+  return 1;
+}
+
+extern "C" CEF_EXPORT void browser_suspend_downloads_v1(const char* cache_path) {
+  CEF_REQUIRE_UIT_RETURN_VOID();
+  auto* context = cache_path && *cache_path
+                      ? CefBrowserContext::FromCachePath(base::FilePath(cache_path)) : nullptr;
+  if (!context || context->AsProfile()->IsOffTheRecord())
+    return;
+  // Only touch managers that currently have a CEF download delegate.
+  for (const auto& [manager, delegate] : RecoveryDelegates()) {
+    if (manager->GetBrowserContext() != context->AsProfile())
+      continue;
+    DownloadManager::DownloadVector items;
+    manager->GetAllDownloads(&items);
+    for (const auto& item : items) {
+      if (item->GetState() == DownloadItem::IN_PROGRESS && CanKeepPartial(item) &&
+          item->GetDownloadFile())
+        static_cast<download::DownloadItemImpl*>(item.get())->DestinationError(
+            download::DOWNLOAD_INTERRUPT_REASON_CRASH, item->GetReceivedBytes(), std::nullopt);
+    }
+  }
+}
