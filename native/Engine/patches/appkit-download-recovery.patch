 namespace {
 
+auto& RecoveryDelegates() {
+  static base::NoDestructor<std::map<DownloadManager*, CefDownloadManagerDelegateImpl*>> delegates;
+  return *delegates;
+}
+
+bool CanKeepPartial(DownloadItem* item) {
+  if (!item || !item->GetURL().SchemeIsHTTPOrHTTPS() || item->IsDangerous() ||
+      item->IsInsecure() || item->IsTransient() || item->AllDataSaved() ||
+      item->GetReceivedBytes() <= 0 || item->GetFullPath().empty())
+    return false;
+  auto headers = item->GetResponseHeaders();
+  if (headers && headers->HasHeaderValue("accept-ranges", "none"))
+    return false;
+  if (item->GetETag().empty() && item->GetLastModifiedTime().empty() &&
+      !base::FeatureList::IsEnabled(download::features::kAllowDownloadResumptionWithoutStrongValidators))
+    return false;
+  if (item->GetState() == DownloadItem::IN_PROGRESS)
+    return true;
+  return item->CanResume() &&
+      download::GetDownloadResumeMode(item->GetURL(), item->GetLastReason(), false, true) ==
+          download::ResumeMode::USER_CONTINUE;
+}
