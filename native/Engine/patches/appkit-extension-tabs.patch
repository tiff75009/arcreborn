+namespace {
+using AppKitTabCreator = int (*)(int source_browser_id, int active,
+                                int pinned, int index);
+AppKitTabCreator appkit_tab_creator = nullptr;
+}  // namespace
+
+extern "C" CEF_EXPORT int browser_set_extension_tab_creator_v1(
+    AppKitTabCreator callback) {
+  CEF_REQUIRE_UIT_RETURN(-1);
+  appkit_tab_creator = callback;
+  return 0;
+}
+
+namespace cef {
+base::expected<BrowserWindowInterface*, std::string>
+CreateAppKitExtensionTab(BrowserWindowInterface& source, bool active,
+                         bool pinned, int index) {
+  CEF_REQUIRE_UIT_RETURN(base::unexpected("Native tab creation requires the UI thread"));
+  if (!appkit_tab_creator) return static_cast<BrowserWindowInterface*>(nullptr);
+  auto source_host = CefBrowserHostBase::GetBrowserForContents(
+      source.GetTabStripModel()->GetActiveWebContents());
+  if (!source_host || !source_host->IsChromeStyle() ||
+      !source_host->is_views_hosted() || !source_host->IsValid()) {
+    return static_cast<BrowserWindowInterface*>(nullptr);
+  }
+  const int created_id = appkit_tab_creator(source_host->GetIdentifier(),
+                                           active, pinned, index);
+  if (created_id == 0) return static_cast<BrowserWindowInterface*>(nullptr);
+  if (created_id < 0) return base::unexpected("Browser could not create the native tab");
+  auto created = CefBrowserHostBase::GetBrowserForBrowserId(created_id);
+  if (!created || !created->IsValid() || !created->IsChromeStyle() ||
+      !created->is_views_hosted() || created.get() == source_host.get()) {
+    return base::unexpected("Invalid native tab returned by Browser");
+  }
+  auto target = ChromeBrowserHostImpl::FromBaseChecked(created);
+  Browser* browser = target->browser();
+  if (!browser || browser->GetProfile() != source.GetProfile() ||
+      browser->tab_strip_model()->count() != 1 ||
+      browser->tab_strip_model()->GetActiveWebContents() != target->GetWebContents()) {
+    return base::unexpected("Native tab profile or contents mismatch");
+  }
+  browser->tab_strip_model()->SetTabPinned(0, pinned);
+  return static_cast<BrowserWindowInterface*>(browser);
+}
+}  // namespace cef
